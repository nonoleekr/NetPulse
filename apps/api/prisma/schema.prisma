generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Monitor {
  id              String        @id @default(cuid())
  name            String
  url             String
  kind            String        @default("HTTP")
  host            String?
  port            Int?
  intervalSeconds Int           @default(60)
  timeoutMs       Int           @default(5000)
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  measurements    Measurement[]
  outages         Outage[]
  diagnostics     DiagnosticRun[]
}

model Measurement {
  id          String   @id @default(cuid())
  monitorId   String
  startedAt   DateTime
  completedAt DateTime @default(now())
  success     Boolean
  latencyMs   Int?
  statusCode  Int?
  errorCode   String?
  errorMessage String?
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, completedAt])
}

model Outage {
  id          String    @id @default(cuid())
  monitorId   String
  startedAt   DateTime
  endedAt     DateTime?
  failureCount Int
  reason      String?
  monitor     Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, startedAt])
}

model DiagnosticRun {
  id           String   @id @default(cuid())
  monitorId    String
  kind         String
  status       String
  startedAt    DateTime
  completedAt  DateTime?
  durationMs   Int?
  capability   String
  resultJson   String?
  errorCode    String?
  errorMessage String?
  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, startedAt])
}

DATABASE_URL="file:./dev.db"
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
# Keep false for normal use. Set true only for local loopback test fixtures.
NETPULSE_ALLOW_LOCAL_TARGETS=false
MAX_MONITORS=100
MAX_RESPONSE_BYTES=1048576
MAX_WEBSOCKET_CLIENTS=25
MAX_WEBSOCKET_PAYLOAD_BYTES=16384
RETENTION_DAYS=30
OUTAGE_FAILURE_THRESHOLD=3
